# Copy to .env and fill in. `make run` and docker-compose read this file.
# .env is gitignored.

# --- required ---
DATABASE_URL=postgres://eetmeter:eetmeter@localhost:5432/eetmeter?sslmode=disable

# Each account authenticates with a TOKEN + DEVICE_ID pair captured from a
# logged-in Mijn Eetmeter app session (a bare email/password login is rejected
# by the live API). In token mode EMAIL and PASSWORD are unused and can be left
# blank / removed. Values are read literally — no need to quote $ or #.
EETMETER_ACCOUNT_A_TOKEN=
EETMETER_ACCOUNT_A_DEVICE_ID=
# EETMETER_ACCOUNT_A_EMAIL=you@example.com     # optional label only
# EETMETER_ACCOUNT_A_PASSWORD=                 # unused when a token is set

EETMETER_ACCOUNT_B_TOKEN=
EETMETER_ACCOUNT_B_DEVICE_ID=
# EETMETER_ACCOUNT_B_EMAIL=partner@example.com
# EETMETER_ACCOUNT_B_PASSWORD=

# --- optional (defaults shown) ---
EETMETER_ACCOUNT_A_LABEL=You
EETMETER_ACCOUNT_B_LABEL=Partner

SYNC_DAILY_TIME=06:00
SYNC_TIMEZONE=Europe/Amsterdam
SYNC_ON_STARTUP=false
# SYNC_DRY_RUN=1  -> every run logs what it WOULD do and writes nothing.
#                   Set this for the first runs to preview the merge.
SYNC_DRY_RUN=false

HTTP_ADDR=:8080
# SYNC_API_TOKEN=          # if set, all routes except /healthz need "Authorization: Bearer <token>"
LOG_LEVEL=info

# Point at the local fake API for development (see `make dev`):
# EETMETER_API_BASE_URL=http://localhost:8090/api
EETMETER_API_BASE_URL=https://api3-mijn.voedingscentrum.nl/api/
EETMETER_APP_VERSION=4.6.0
EETMETER_PLATFORM=iOS
