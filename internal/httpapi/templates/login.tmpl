{{define "content"}}
<h1>Sign in</h1>
{{if .Error}}<p class="fail">{{.Error}}</p>{{end}}
<form method="post" action="/ui/login" style="max-width:22rem">
  <label for="secret">Access token</label>
  <input id="secret" type="password" name="secret" autocomplete="current-password" autofocus>
  <div style="margin-top:.8rem"><button class="primary" type="submit">Sign in</button></div>
</form>
{{end}}
